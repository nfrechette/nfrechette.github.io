---
layout: null
---

<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">

 {% comment %}
   The site moved from http to https. The feed and entry IDs keep the old http
   prefix: if an ID changes, feed readers show the entry again as a new post.
 {% endcomment %}
 {% assign feed_id_prefix = "http://nfrechette.github.io" %}

 <title>{{ site.title | xml_escape }}</title>
 <link href="{{ site.url }}{{ site.baseurl }}/atom.xml" rel="self" type="application/atom+xml"/>
 <link href="{{ site.url }}{{ site.baseurl }}/"/>
 <updated>{{ site.time | date_to_xmlschema }}</updated>
 <id>{{ feed_id_prefix }}</id>
 <author>
   <name>{{ site.author.name }}</name>
   <email>{{ site.author.email }}</email>
 </author>

 {% comment %}
   The feed holds only the newest posts, because each entry holds the full post.
   Feed readers keep the older entries that they already have.
 {% endcomment %}
 {% comment %}
   Some feed readers do not resolve root-relative URLs, such as "/public/foo.jpg".
   The replace filters make these URLs absolute. Posts must not use protocol-relative URLs ("//host/..."),
   because these filters would break them.
 {% endcomment %}
 {% assign site_root = site.url | append: site.baseurl | append: "/" %}
 {% for post in site.posts limit: 10 %}
 {% assign post_content = post.content | replace: 'href="/', 'href="SITE_ROOT' | replace: 'src="/', 'src="SITE_ROOT' | replace: 'poster="/', 'poster="SITE_ROOT' | replace: 'SITE_ROOT', site_root %}
 <entry>
   <title>{{ post.title | xml_escape }}</title>
   <link href="{{ site.url }}{{ post.url }}"/>
   <published>{{ post.date | date_to_xmlschema }}</published>
   <updated>{{ post.date | date_to_xmlschema }}</updated>
   <id>{{ feed_id_prefix }}{{ site.baseurl }}{{ post.id }}</id>
   {% for tag in post.tags %}{% assign topic_page = site.pages | where: "topic", tag | first %}<category term="{{ tag }}"{% if topic_page %} label="{{ topic_page.title | xml_escape }}"{% endif %}/>{% endfor %}
   <content type="html">{{ post_content | xml_escape }}</content>
 </entry>
 {% endfor %}

</feed>
